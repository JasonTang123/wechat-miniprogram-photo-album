.page {
  padding: 80rpx 48rpx;
}

.hero {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
  margin-bottom: 48rpx;
}

.title {
  font-size: 48rpx;
  font-weight: 600;
  letter-spacing: 2rpx;
}

.subtitle {
  font-size: 28rpx;
  color: #666;
}

.card {
  background: #fff;
  border-radius: 16rpx;
  padding: 32rpx;
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.line {
  color: #444;
  line-height: 1.6;
}
